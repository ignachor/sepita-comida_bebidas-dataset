# Copy to .env (never commit it) and fill in.
# Keep the quotes: the file is sourced by bash. URL-encode special chars in the password (@ -> %40).
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4).
DATABASE_URL='postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'
